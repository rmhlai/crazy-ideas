# Copy to .env.local and fill in.
ANTHROPIC_API_KEY=
# Model used to read order forms and ingredient lists (can also be changed in Settings).
ANTHROPIC_MODEL=claude-sonnet-5
# Set to true to let other devices on your home Wi-Fi reach the app (binds 0.0.0.0).
ALLOW_LAN=false
# Port (default 3000)
PORT=3000
# Where the database and uploaded files live (default ./data)
# LUNCHBOX_DATA_DIR=./data
